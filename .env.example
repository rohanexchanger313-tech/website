# Optional server-side Binance P2P-compatible endpoint. Leave unset to show
# the transparent "unavailable" state instead of fabricating a market quote.
BINANCE_P2P_API_URL=
# Public site URL used for canonical and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://example.com
# Server-only BNB Smart Chain RPC endpoint used for transaction verification.
BSC_RPC_URL=
